  "resource_type": "Tool",
  "status": "active",
  "capability": {
    "summary": "Create a named Git branch in a specified local repository.",
    "description": "Use when a repository needs a new named branch for an isolated line of work. It creates branch metadata only; it does not list branches, commit changes, stage files, or inspect history.",
    "domain_tags": [
      "git",
      "branch-creation",
      "version-control"
    ],
    "core_primitives": [
      "create_named_branch",
      "initialize_feature_branch",
      "branch_repository_history"
    ],
    "problem_space": "Create a named branch in a known local Git repository. This is branch mutation, distinct from inspecting existing branches, staging changes, creating commits, or viewing history."
  },
  "constraint": {
    "io_signature": "Input: local Git repository path and new branch name. Output: JSON branch creation result.",
    "accepted_inputs": [
      "a local directory containing a Git repository",
      "a valid new branch name"
    ],
    "output_shape": "JSON result identifying the created branch.",
    "limitations": [
      "does not list or switch existing branches",
      "does not stage files or create a commit"
    ]
  },
