# Copy these names into the project-root .env file. Never commit the real key.
LLM_API_KEY=replace_with_your_new_key
LLM_BASE_URL=https://svip.xty.app/v1
SGAR_MODEL_PROXY=
# Optional project-scoped proxy for declared network Tools only. Leave empty for direct access.
SGAR_TOOL_HTTP_PROXY=
SGAR_TOOL_HTTPS_PROXY=
SGAR_TOOL_NO_PROXY=localhost,127.0.0.1
